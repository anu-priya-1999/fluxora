{
  "name": "fluxora",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:migrate": "pnpm --filter @fluxora/db migrate",
    "db:seed": "pnpm --filter @fluxora/db seed",
    "db:reset": "pnpm --filter @fluxora/db reset",
    "api:start": "pnpm --filter @fluxora/api start",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --if-present dev",
    "lint": "eslint .",
    "lint:evidence": "node --experimental-strip-types scripts/evidence-lint.ts",
    "format": "pnpm -r --if-present format",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.0"
  }
}
